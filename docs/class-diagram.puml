
@startuml
class TodoService {
  - storage
  - tasks
  + addTask(description, type)
  + toggleComplete(id)
  + deleteTask(id)
  + getWorkloadSummary()
}

class LocalStorageHandler {
  + load()
  + save(tasks)
}

class TodoRenderer {
  - container
  + render(tasks, service)
  + buildTaskRow(task)
}

class TodoController {
  - service
  - renderer
  + start()
  + addTask(description, type)
}

TodoService --> LocalStorageHandler : uses
TodoRenderer --> TodoService : reads tasks
TodoController --> TodoService : coordinates
TodoController --> TodoRenderer : coordinates
@enduml
